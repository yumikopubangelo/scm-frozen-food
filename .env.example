# Salin file ini menjadi .env.local lalu isi nilainya. .env.local TIDAK BOLEH di-commit.
# Nilai diambil dari Supabase Dashboard -> Project Settings -> API / Data API.

# URL project, contoh: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) atau anon key lama. Aman dipakai di browser
# karena akses data dijaga oleh Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya untuk skrip lokal (migrasi & tes SQL), TIDAK dipakai aplikasi & TIDAK dipasang di Vercel.
# Supabase Dashboard -> tombol "Connect" -> Session pooler -> URI (ganti [YOUR-PASSWORD]).
DATABASE_URL=
